{
  "name": "usc-schedule-maker-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Nightly scraper: classes.usc.edu + RMP snapshot + final exam table -> TermData JSON in Supabase Storage",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "scrape": "tsx src/index.ts",
    "fixture": "tsx src/make-fixture.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
