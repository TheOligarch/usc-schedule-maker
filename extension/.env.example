# Copy to .env (never commit .env).
# Supabase anon/publishable key for project mmdvgvpckweiklkbuxvy.
# It is a public client key, but it is injected at build time rather than hardcoded.
VITE_SUPABASE_ANON_KEY=

# Single integration flag. "false" (default) uses the real engine in ../engine and the
# deployed Supabase Edge Functions, same as the release zip. "true" backs the schedule
# engine and the AI interview/explanations with the local mocks in src/mocks/ (demo
# mode; `npm run dev:mock` sets it for one run). See README "Integration flag".
# `npm run release` always builds with "false".
VITE_USE_MOCKS=false
