# Copy to .env (never commit .env).
# Supabase anon/publishable key for project mmdvgvpckweiklkbuxvy.
# It is a public client key, but it is injected at build time rather than hardcoded.
VITE_SUPABASE_ANON_KEY=

# Single integration flag. "true" (default) backs the schedule engine and the AI
# interview/explanations with the local mocks in src/mocks/. "false" calls the deployed
# Supabase Edge Functions (and the real engine once it is wired in; see README
# "Integration flag"). `npm run release` always builds with "false".
VITE_USE_MOCKS=true
