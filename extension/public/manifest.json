{
  "manifest_version": 3,
  "name": "USC Schedule Maker",
  "short_name": "Schedule Maker",
  "version": "0.1.10",
  "description": "Builds every schedule that fits your requirements and ranks them by what you actually want. Adds a Schedule Maker tab to USC WebReg.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open USC Schedule Maker" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["https://webreg.usc.edu/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "host_permissions": [
    "https://classes.usc.edu/*",
    "https://mmdvgvpckweiklkbuxvy.supabase.co/*"
  ],
  "web_accessible_resources": [
    { "resources": ["index.html", "assets/*", "icons/*"], "matches": ["https://webreg.usc.edu/*"] }
  ]
}
